# Скопируйте в .env (локально) или задайте в панели Timeweb Cloud -> Переменные.
# НИКОГДА не публикуйте .env в репозиторий!

# Случайный ключ (50+ символов):
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=замените-на-случайный-ключ

# На сервере всегда False (статику раздаёт WhiteNoise):
DJANGO_DEBUG=False

# Домен Timeweb Cloud (через запятую, без пробелов):
# Можно указать * для любого домена (удобно на первом деплое):
DJANGO_ALLOWED_HOSTS=ваш-домен.ru,www.ваш-домен.ru

# После подключения HTTPS:
DJANGO_CSRF_TRUSTED_ORIGINS=https://ваш-домен.ru,https://www.ваш-домен.ru
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_SSL_REDIRECT=False

# Вход в /admin/ (создаётся автоматически при первом запуске):
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=задайте-надёжный-пароль
DJANGO_SUPERUSER_EMAIL=admin@example.com
